<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Only name and implied_ids are set here. The heading these groups sit
         under, and their help text, are applied from Python afterwards, because
         Odoo 20 removed res.groups.category_id in favour of a privilege link. -->
    <record id="group_creative_user" model="res.groups">
        <field name="name">Creative Studio User</field>
    </record>

    <record id="group_art_director" model="res.groups">
        <field name="name">Art Director</field>
        <field name="implied_ids" eval="[(4, ref('group_creative_user'))]"/>
    </record>

    <record id="group_creative_director" model="res.groups">
        <field name="name">Creative Director</field>
        <field name="implied_ids" eval="[(4, ref('group_art_director'))]"/>
    </record>

    <function model="res.groups" name="_c2p_describe_groups" eval="[
        'Creative Studio',
        {
            'c2p_creative_studio.group_creative_user':
                'Works on briefs, routes and assets. Cannot record review decisions or approve a brief.',
            'c2p_creative_studio.group_art_director':
                'Art-directs the work: shortlists, selects and combines routes, runs review rounds and requests changes.',
            'c2p_creative_studio.group_creative_director':
                'Signs off the creative: approves briefs and may delete records.',
        },
    ]"/>

    <!-- Multi-company record rules. Every model carries a stored company_id, so
         the same rule shape applies to all four. -->
    <record id="rule_creative_brief_company" model="ir.rule">
        <field name="name">Creative Brief: multi-company</field>
        <field name="model_id" ref="model_c2p_creative_brief"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_creative_concept_company" model="ir.rule">
        <field name="name">Concept Route: multi-company</field>
        <field name="model_id" ref="model_c2p_creative_concept"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_creative_asset_company" model="ir.rule">
        <field name="name">Creative Asset: multi-company</field>
        <field name="model_id" ref="model_c2p_creative_asset"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_creative_review_company" model="ir.rule">
        <field name="name">Review Round: multi-company</field>
        <field name="model_id" ref="model_c2p_creative_review"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
