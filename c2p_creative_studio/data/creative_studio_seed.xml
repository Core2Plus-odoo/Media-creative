    <record id="seed_asset_mango_print" model="c2p.creative.asset">
        <field name="name">Mango Season - Press Insert</field>
        <field name="brief_id" ref="seed_brief_mango_season"/>
        <field name="concept_id" ref="seed_concept_season_table"/>
        <field name="asset_type">print</field>
        <field name="version">2</field>
    </record>

    <record id="seed_asset_mango_social" model="c2p.creative.asset">
        <field name="name">Mango Season - Reels Cutdowns</field>
        <field name="brief_id" ref="seed_brief_mango_season"/>
        <field name="concept_id" ref="seed_concept_season_table"/>
        <field name="asset_type">social</field>
        <field name="version">1</field>
        <field name="state">review</field>
    </record>

    <record id="seed_review_mango_kv_1" model="c2p.creative.review">
        <field name="asset_id" ref="seed_asset_mango_kv"/>
        <field name="decision">changes</field>
        <field name="date" eval="(DateTime.now() - relativedelta(days=26)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="feedback" type="html"><p>Fruit reads as styled. Shoot it on a real table, mid-meal.</p></field>
    </record>

    <record id="seed_review_mango_kv_2" model="c2p.creative.review">
        <field name="asset_id" ref="seed_asset_mango_kv"/>
        <field name="decision">approved</field>
        <field name="date" eval="(DateTime.now() - relativedelta(days=21)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="feedback" type="html"><p>Approved. Warmth is there now.</p></field>
    </record>

    <record id="seed_review_mango_print_1" model="c2p.creative.review">
        <field name="asset_id" ref="seed_asset_mango_print"/>
        <field name="decision">changes</field>
        <field name="date" eval="(DateTime.now() - relativedelta(days=19)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="feedback" type="html"><p>Headline sits too low. Raise it and let the crate breathe.</p></field>
    </record>

    <record id="seed_review_mango_print_2" model="c2p.creative.review">
        <field name="asset_id" ref="seed_asset_mango_print"/>
        <field name="decision">approved</field>
        <field name="date" eval="(DateTime.now() - relativedelta(days=16)).strftime('%Y-%m-%d %H:%M:%S')"/>
