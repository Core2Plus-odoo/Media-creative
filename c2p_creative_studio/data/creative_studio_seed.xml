    <record id="seed_review_recap_2" model="c2p.creative.review">
        <field name="asset_id" ref="seed_asset_recap_social"/>
        <field name="decision">approved</field>
        <field name="date" eval="(DateTime.now() - relativedelta(days=108)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="feedback" type="html"><p>Approved. Much calmer.</p></field>
    </record>

    <!-- Attach whichever creatives exist on this database as the designers. -->
    <function model="c2p.creative.asset" name="_c2p_seed_assign_designers"/>
</odoo>
