<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c2p_creative_asset_form" model="ir.ui.view">
        <field name="name">c2p.creative.asset.form</field>
        <field name="model">c2p.creative.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_send_review" string="Send for Review" type="object" class="btn-primary"
                            invisible="state != 'wip'"/>
                    <button name="action_new_version" string="Upload New Version" type="object"
                            invisible="state != 'changes'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="wip,review,changes,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reviews" type="object" class="oe_stat_button" icon="fa-comments-o">
                            <field name="review_count" widget="statinfo" string="Reviews"/>
                        </button>
                    </div>
                    <field name="preview" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. OOH Key Visual - Frame 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="brief_id"/>
                            <field name="concept_id"/>
                            <field name="asset_type"/>
                        </group>
                        <group>
                            <field name="designer_id"/>
                            <field name="task_id"/>
                            <field name="version"/>
                            <field name="turnaround_days" invisible="not turnaround_days"/>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Review Rounds" name="reviews">
                            <field name="review_ids" context="{'default_asset_id': id}">
                                <list>
                                    <field name="round"/>
                                    <field name="date"/>
                                    <field name="reviewer_id" widget="many2one_avatar_user"/>
                                    <field name="decision" widget="badge"/>
                                    <field name="feedback"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_c2p_creative_asset_list" model="ir.ui.view">
        <field name="name">c2p.creative.asset.list</field>
        <field name="model">c2p.creative.asset</field>
        <field name="arch" type="xml">
            <list string="Assets">
                <field name="brief_id"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="designer_id"/>
                <field name="version"/>
                <field name="review_count"/>
                <field name="turnaround_days" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_c2p_creative_asset_kanban" model="ir.ui.view">
        <field name="name">c2p.creative.asset.kanban</field>
        <field name="model">c2p.creative.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="brief_id" class="text-muted"/>
                        <div class="small">
                            <field name="asset_type"/> - v<field name="version"/>
                        </div>
                        <footer>
                            <field name="designer_id"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_c2p_creative_asset_search" model="ir.ui.view">
        <field name="name">c2p.creative.asset.search</field>
        <field name="model">c2p.creative.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="brief_id"/>
                <field name="designer_id"/>
                <filter name="needs_review" string="Awaiting My Review" domain="[('state', '=', 'review')]"/>
                <filter name="changes" string="Changes Requested" domain="[('state', '=', 'changes')]"/>
                <group>
                    <filter name="group_brief" string="Brief" context="{'group_by': 'brief_id'}"/>
                    <filter name="group_designer" string="Designer" context="{'group_by': 'designer_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'asset_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_c2p_creative_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">c2p.creative.asset</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_c2p_creative_review_list" model="ir.ui.view">
        <field name="name">c2p.creative.review.list</field>
        <field name="model">c2p.creative.review</field>
        <field name="arch" type="xml">
            <list string="Review Rounds">
                <field name="brief_id"/>
                <field name="asset_id"/>
                <field name="round"/>
                <field name="date"/>
                <field name="reviewer_id" widget="many2one_avatar_user"/>
                <field name="decision" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_c2p_creative_review_form" model="ir.ui.view">
        <field name="name">c2p.creative.review.form</field>
        <field name="model">c2p.creative.review</field>
        <field name="arch" type="xml">
            <form string="Review Round">
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="round"/>
                        </group>
                        <group>
                            <field name="reviewer_id"/>
                            <field name="date"/>
                            <field name="decision"/>
                        </group>
                    </group>
                    <field name="feedback" placeholder="What works, what must change..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c2p_creative_review" model="ir.actions.act_window">
        <field name="name">Review Rounds</field>
        <field name="res_model">c2p.creative.review</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
